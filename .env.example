# Variables de entorno
# Copia este archivo a .env y ajusta los valores según tu entorno.

# Base de datos SQLite (ruta local al archivo .db)
DATABASE_URL=file:./db/custom.db

# Secreto de NextAuth (genera uno propio con: openssl rand -base64 32)
# NO usar el valor por defecto en producción
NEXTAUTH_SECRET=change-this-to-a-random-secret-in-production

# URL de la aplicación (sin slash final)
NEXTAUTH_URL=http://localhost:3000
