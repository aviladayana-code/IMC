// Prisma schema - Kinemetrix: Evaluación Antropométrica e IMC
// Documentación: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Profesional evaluador (cuenta con acceso a la aplicación)
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  /// Hash bcrypt de la contraseña
  password      String
  /// Credenciales profesionales (Lic. Educación Física, Médico, etc.)
  credential    String?
  /// Especialidad o disciplina (Antropometría ISAK, Fisiología, etc.)
  specialty     String?
  role          String   @default("evaluator")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subjects      Subject[]
  evaluations   Evaluation[]
}

/// Evaluado / sujeto de evaluación
model Subject {
  id             String       @id @default(cuid())
  /// Nombre completo del evaluado
  fullName       String
  /// Identificación, DNI, pasaporte o código interno
  identification String       @unique
  /// Sexo biológico de referencia: "M" | "F"
  sex            String
  /// Observaciones generales del sujeto (no de una evaluación específica)
  observations   String?
  /// Contexto deportivo / actividad (ej. Rugby, sedentario, hipertrofia)
  sportContext   String?
  /// Avatar de iniciales (autocalculado en cliente)
  createdBy      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User?        @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  evaluations    Evaluation[]

  @@index([fullName])
  @@index([identification])
}

/// Evaluación antropométrica individual (puede haber varias por sujeto)
model Evaluation {
  id                 String   @id @default(cuid())
  subjectId          String
  /// Fecha real de la evaluación (no de creación del registro)
  evaluationDate     DateTime
  /// Edad declarada en la evaluación (años cumplidos)
  age                 Int
  /// Peso corporal en kg
  weight              Float
  /// Estatura en cm
  height              Float
  /// IMC calculado (kg/m²) - almacenado para histórico
  bmi                 Float
  /// Clasificación OMS resultante
  classification      String
  /// Observaciones clínicas y contexto de la medición
  observations        String?
  /// Contexto rápido de medición (ayuno, post-entreno, etc.) - tags separados por coma
  measurementContext  String?
  /// Indica si aplica criterios pediátricos (edad < 20)
  isPediatric         Boolean  @default(false)
  /// Notas / recomendaciones del profesional
  professionalNotes   String?
  /// Datos del profesional evaluador (instantánea al momento de la eval)
  evaluatorName       String?
  evaluatorCredential String?
  evaluatorId        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  subject            Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  evaluator          User?    @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([subjectId])
  @@index([evaluationDate])
}
